# Copia este archivo como .env y reemplaza los valores. Nunca subas .env al repositorio.

# Secreto HMAC para firmar los JWT (mínimo 32 caracteres). Genera uno con:
#   openssl rand -base64 48
JWT_SECRET=change-me-with-a-random-secret-of-at-least-32-chars
JWT_ISSUER=dev-springboot-postgres-pokemon
JWT_EXPIRATION=PT1H

APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change-me
